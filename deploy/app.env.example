# ─────────────────────────────────────────────────────────────
# 生产环境变量样板 → 安装到 /etc/wechat-pipeline-cloud/app.env
#
# ⚠️ systemd 的 EnvironmentFile **不做引号剥离**：写 KEY="value" 时，
#    引号会被当成值的一部分（于是 DATABASE_URL 变成带引号的串，连不上库）。
#    所以这里一律不加引号。值里有空格也要原样写（systemd 按行读）。
# ⚠️ 文件权限必须是 600：里面含数据库口令与主密钥。
# ─────────────────────────────────────────────────────────────

# ── 必填 ──
NODE_ENV=production

# MySQL。SQLite 仅供本地开发，**生产用 SQLite 会在并发写入时炸**
DATABASE_URL=mysql://wechat:CHANGE_ME@127.0.0.1:3306/wechat_pipeline?connection_limit=10

# 凭据加密主密钥：32 字节 base64。
# 生成：openssl rand -base64 32
# ⚠️ 一旦有数据写入就**永远不能改**，改了已存的 AppSecret 全部解不开
APP_SECRET_KEY=CHANGE_ME_GENERATE_WITH_openssl_rand_-base64_32

# ── 选填（不填则用下列默认值）──
PORT=8787
LOG_LEVEL=info

# 内容落盘目录（文章 HTML、封面 PNG）。必须可写，且要和 logrotate 配置一致
CONTENT_DIR=/opt/wechat-pipeline-cloud/var/content

# style_dna.json / topic_seeds.json 所在目录
CONFIG_DIR=/opt/wechat-pipeline-cloud/config

# 微信接口超时（毫秒）
HTTP_TIMEOUT_MS=30000

# LLM 调用超时（毫秒）。改大要同步改 nginx 的 proxy_read_timeout（当前 330s）
LLM_TIMEOUT_MS=300000

