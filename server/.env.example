# 生产配置模板。复制到 /etc/wechat-pipeline/app.env 后填真实值，并 chmod 600。
# 本文件不含任何真实密钥，可安全入库。

# MySQL（生产）
DATABASE_URL="mysql+pymysql 不适用：Prisma 用 mysql://user:pass@host:3306/wechat_pipeline"
# 正确写法示例：
# DATABASE_URL="mysql://wechat:强密码@127.0.0.1:3306/wechat_pipeline"

PORT=8787
NODE_ENV=production
LOG_LEVEL=info

# 管理界面登录口令
ADMIN_PASSWORD=改成强口令

# 登录态签名密钥
JWT_SECRET=随机长字符串

# AES-256-GCM 主密钥：必须是 32 字节的 base64。
# 生成：node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# 警告：变更此值会导致已入库的 AppSecret 无法解密，必须重新填写。
APP_SECRET_KEY=

# 内容与封面落盘目录
# CONTENT_DIR=/var/lib/wechat-pipeline/content
# CONFIG_DIR=/etc/wechat-pipeline/config

HTTP_TIMEOUT_MS=30000
LLM_TIMEOUT_MS=300000
