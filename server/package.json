{
  "name": "wechat-pipeline-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --experimental-strip-types --watch src/index.ts",
    "start": "node --experimental-strip-types src/index.ts",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "schema:sqlite": "node scripts/gen-sqlite-schema.mjs",
    "sqlite:generate": "prisma generate --schema prisma/schema.sqlite.prisma",
    "sqlite:push": "prisma db push --schema prisma/schema.sqlite.prisma",
    "scheduler": "node --experimental-strip-types src/cli/scheduler.ts",
    "scheduler:once": "node --experimental-strip-types src/cli/scheduler.ts --once",
    "migrate": "node --experimental-strip-types src/cli/migrate.ts",
    "migrate:dry": "node --experimental-strip-types src/cli/migrate.ts --dry-run",
    "fix:article-idem": "node --experimental-strip-types scripts/fix-article-idem.ts",
    "smoke:models": "node --experimental-strip-types scripts/smoke-models.ts",
    "smoke:cover": "node --experimental-strip-types scripts/smoke-cover.ts",
    "smoke:migrate": "node --experimental-strip-types scripts/smoke-migrate.ts",
    "smoke:angles": "node --experimental-strip-types scripts/smoke-angles.ts",
    "smoke:bulk": "node --experimental-strip-types scripts/smoke-bulk-delete.ts",
    "verify:bulk": "node --experimental-strip-types scripts/verify-bulk-delete.ts",
    "verify:zodiac": "node --experimental-strip-types scripts/verify-zodiac.ts",
    "smoke:lint": "node --experimental-strip-types scripts/smoke-lint.ts",
    "smoke:style": "node --experimental-strip-types scripts/smoke-style-prompts.ts",
    "smoke:auth": "node --experimental-strip-types scripts/smoke-auth.ts",
    "prune:old": "node --experimental-strip-types scripts/prune-old-style.ts",
    "demo:write": "node --experimental-strip-types scripts/demo-write.ts",
    "verify:length": "node --experimental-strip-types scripts/verify-length.ts",
    "measure:form": "node --experimental-strip-types scripts/measure-form.ts",
    "model:local": "node --experimental-strip-types scripts/setup-local-model.ts",
    "smoke:p2": "node --experimental-strip-types scripts/smoke-p2.ts",
    "smoke:comic-align": "node --experimental-strip-types scripts/smoke-comic-align.ts",
    "smoke:comic-qc": "node --experimental-strip-types scripts/smoke-comic-qc.ts",
    "smoke:comic-fallback": "node --experimental-strip-types scripts/smoke-comic-fallback.ts",
    "smoke:quote-card": "node --experimental-strip-types scripts/smoke-quote-card.ts",
    "fix:cover-paths": "node --experimental-strip-types scripts/fix-cover-paths.ts",
    "seed:pipelines": "node --experimental-strip-types scripts/seed-pipelines.ts",
    "seed:admin": "node --experimental-strip-types scripts/seed-admin.ts",
    "smoke:users": "node --experimental-strip-types scripts/smoke-users.ts",
    "smoke:ownership": "node --experimental-strip-types scripts/smoke-ownership.ts",
    "migrate:automation": "node --experimental-strip-types scripts/migrate-automation.ts",
    "smoke:automation": "node --experimental-strip-types scripts/smoke-automation.ts",
    "restore:models": "node --experimental-strip-types scripts/restore-models-backup.ts",
    "migrate:track-config": "node --experimental-strip-types scripts/migrate-track-config.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "puppeteer-core": "^25.13.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.9.0",
    "pino-pretty": "^13.2.0",
    "prisma": "^5.22.0",
    "typescript": "^5.6.3"
  }
}
